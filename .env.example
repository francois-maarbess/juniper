# Local development only. Copy this file to .env and replace the secret values.
DATABASE_URL=postgresql://juniper:juniper-local@localhost:5433/juniper
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:8081
APP_PUBLIC_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPPORT_EMAIL=

# Email verification and password reset. Leave blank locally to use development links.
RESEND_API_KEY=
EMAIL_FROM="Juniper <hello@your-verified-domain.example>"

# Private tutor document storage. Local development uses the filesystem.
TUTOR_DOCUMENT_STORAGE=local
TUTOR_DOCUMENTS_DIR=.local/tutor-documents
# For S3-compatible production storage:
# TUTOR_DOCUMENT_STORAGE=s3
# STORAGE_BUCKET=
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_FORCE_PATH_STYLE=false
JUNIPER_ADMIN_USER_IDS=

# Optional monitoring and native push setup.
SENTRY_DSN=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional TURN relay for calls on restrictive networks. The API returns short-lived
# credentials to session participants; never put the shared secret in the mobile app.
TURN_SERVER_URLS=
TURN_SHARED_SECRET=
